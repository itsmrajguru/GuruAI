PORT=5000
MONGO_URI=mongodb://localhost:27017/guruai
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=onboarding@resend.dev
CLIENT_URL=http://localhost:5173

# Google Gemini API key (required)
# we are planning to use totally 4 gemini api keys from diffrent accounts
# so that the service never goes off 
# this occours because free-tier gemini api keys have restriction
# over 100 messages in a day and also something in minutes
# so by using multiplle keys , we will rotate into diffrent keys
# and the user wont feel any inconvinience

GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_API_KEY_3=your_third_gemini_api_key

