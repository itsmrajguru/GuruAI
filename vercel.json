{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://guruai-backend.onrender.com/api/$1" },
    { "source": "/auth/(.*)", "destination": "https://guruai-backend.onrender.com/auth/$1" },
    { "source": "/ai/(.*)", "destination": "https://guruai-backend.onrender.com/ai/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
